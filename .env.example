# Обычно этот файл не нужен: ./deploy/setup.sh создаёт .env сам.

# Секрет для программы на ПК (генерится setup.sh)
PUSH_TOKEN=change-me-long-random-string
# Ключ для просмотра в обычном браузере
VIEW_KEY=change-me-too

# Telegram: токен бота и кто может смотреть (Telegram ID через запятую)
BOT_TOKEN=
ALLOWED_IDS=        # твой Telegram ID, узнать: написать боту @userinfobot
# Публичный адрес - для кнопки Mini App в боте и ссылки в уведомлениях
PUBLIC_URL=https://live.example.com

# Обновления программы при приватном репозитории: fine-grained token, Contents: Read-only
GH_TOKEN=

# Локальный порт контейнера (наружу только через Caddy)
RELAY_PORT=8090

# Необязательно
# TIMEZONE=Europe/Amsterdam   # часовой пояс для времени в боте
# ALERTS=0              # не присылать уведомления о падении трансляции
# ALERT_AFTER=60        # через сколько секунд простоя присылать уведомление
# SET_MENU_BUTTON=0     # не трогать кнопку меню бота
# MAX_VIEWERS=20
